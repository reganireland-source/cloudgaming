# =============================================================================
# CloudGaming Hub BACKEND settings (set these on Railway → backend → Variables)
# Do NOT add these to Vercel — the frontend only needs NEXT_PUBLIC_API_URL.
# =============================================================================
NODE_ENV=production
# PORT is provided by Railway automatically.

# ---- Required ---------------------------------------------------------------
# On Railway use a reference to the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@localhost:5432/cloudgaming
# Signs sign-in tokens. Long and random, e.g. the output of: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Encrypts every user's cloud keys before they're stored. Long and random
# (openssl rand -hex 32). NEVER change or lose it: saved keys become unreadable.
CREDENTIALS_ENCRYPTION_KEY=change-me-to-a-different-long-random-string

# ---- Public addresses (required for Google/Apple sign-in; FRONTEND_URL also
#      restricts which website may call the API) --------------------------------
# The Vercel site, no trailing slash
FRONTEND_URL=https://your-app.vercel.app
# This backend's public URL INCLUDING /api (Railway → Settings → Networking)
API_PUBLIC_URL=https://your-backend.up.railway.app/api

# ---- Optional: "Continue with Google" ------------------------------------------
# Google Cloud console → APIs & Services → Credentials → Create OAuth client ID
# (Web application). Authorised redirect URI:
#   <API_PUBLIC_URL>/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional: "Continue with Apple" -------------------------------------------
# developer.apple.com → Identifiers → Services ID (with Sign in with Apple,
# return URL <API_PUBLIC_URL>/auth/oauth/apple/callback) + a Sign in with Apple
# key (.p8). Paste the .p8 contents; newlines may be written as \n.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- Cloud accounts ------------------------------------------------------------
# Nothing to set here: each USER adds their own cloud keys on the Config page,
# where they're checked and stored encrypted. The server holds no cloud keys.

# ---- Misc ------------------------------------------------------------------------
LOG_LEVEL=info
