NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/cloudgaming

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Cloud Provider Configuration
AWS_REGION=ap-southeast-1
AZURE_SUBSCRIPTION_ID=your-subscription-id
GCP_PROJECT_ID=your-project-id

# Gaming AMI Configuration
# Use custom Packer-built AMI for faster instance startup
# Build with: cd infrastructure/packer && ./validate-and-build.sh
CLOUDGAMING_AMI_ID=ami-0c55b159cbfafe1f0

# SSH Configuration for CloudyPad Setup
# SSH_KEY_PATH: Private key for connecting to Windows instances (created via AWS EC2 key pair)
# SSH_USERNAME: Windows administrator username (default: Administrator)
# SSH_TIMEOUT_MS: Timeout for SSH commands (default: 300000ms = 5min)
# SSH_RETRY_DELAY_MS: Delay between connection retry attempts (default: 10000ms = 10sec)
SSH_KEY_PATH=/root/.ssh/cloudgaming-key.pem
SSH_USERNAME=Administrator
SSH_TIMEOUT_MS=300000
SSH_RETRY_DELAY_MS=10000

# Note: SSH key must be created in AWS before instances launch
# aws ec2 create-key-pair --key-name cloudgaming-key --region ap-southeast-1 \
#   --query 'KeyMaterial' --output text > ~/.ssh/cloudgaming-key.pem
# chmod 600 ~/.ssh/cloudgaming-key.pem

# Optional: Mail service (for alerts)
MAIL_SERVICE=smtp
MAIL_FROM=noreply@cloudgaming.dev

# Logging
LOG_LEVEL=info
