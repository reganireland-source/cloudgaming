/**
 * EXAMPLE: Complete implementation of credential handling in auth routes
 *
 * This shows how to handle the /api/auth/cloud-credentials endpoint
 * with encryption, validation, and per-user isolation.
 */

import { Router, Request, Response } from 'express';
import { query } from '../../config/database';
import crypto from 'crypto';
import jwt from 'jsonwebtoken';
import { env } from '../../config/env';
import { getProvider } from '../../providers';

const router = Router();

// Extend Express Request to include userId from JWT
declare global {
  namespace Express {
    interface Request {
      userId?: string;
    }
  }
}

// ============================================================================
// ENCRYPTION UTILITIES
// ============================================================================

interface EncryptedCredential {
  iv: string;
  encrypted: string;
  algorithm: string;
}

/**
 * Encrypt credentials with AES-256-GCM
 * Each credential object gets a unique IV
 */
const encryptCredentials = (credentials: any): EncryptedCredential => {
  const encryptionKey = env.CREDENTIALS_ENCRYPTION_KEY;
  if (!encryptionKey) {
    throw new Error('CREDENTIALS_ENCRYPTION_KEY not set in environment');
  }

  // Generate random IV for this encryption
  const iv = crypto.randomBytes(16);

  // Derive key from encryption key (consistent across calls with same key)
  const key = crypto.scryptSync(encryptionKey, 'salt', 32);

  // Create cipher with GCM mode (provides authentication)
  const cipher = crypto.createCipheriv('aes-256-gcm', key, iv);

  // Encrypt the credentials JSON
  let encrypted = cipher.update(JSON.stringify(credentials), 'utf8', 'hex');
  encrypted += cipher.final('hex');

  // Get authentication tag (prevents tampering)
  const authTag = cipher.getAuthTag();

  // Return encrypted credential object
  return {
    iv: iv.toString('base64'),
    encrypted: Buffer.concat([Buffer.from(encrypted, 'hex'), authTag]).toString('base64'),
    algorithm: 'aes-256-gcm',
  };
};

/**
 * Decrypt credentials with AES-256-GCM
 */
const decryptCredentials = (encryptedData: EncryptedCredential): any => {
  const encryptionKey = env.CREDENTIALS_ENCRYPTION_KEY;
  if (!encryptionKey) {
    throw new Error('CREDENTIALS_ENCRYPTION_KEY not set in environment');
  }

  // Derive the same key
  const key = crypto.scryptSync(encryptionKey, 'salt', 32);

  // Get IV from stored value
  const iv = Buffer.from(encryptedData.iv, 'base64');

  // Get encrypted data and auth tag
  const data = Buffer.from(encryptedData.encrypted, 'base64');
  const authTag = data.slice(-16); // Last 16 bytes are auth tag
  const ciphertext = data.slice(0, -16); // Everything else is ciphertext

  // Create decipher
  const decipher = crypto.createDecipheriv('aes-256-gcm', key, iv);

  // Set auth tag for verification
  decipher.setAuthTag(authTag);

  // Decrypt
  let decrypted = decipher.update(ciphertext);
  decrypted = Buffer.concat([decrypted, decipher.final()]);

  // Parse and return credentials
  return JSON.parse(decrypted.toString('utf8'));
};

// ============================================================================
// VALIDATION UTILITIES
// ============================================================================

/**
 * Validate AWS credentials by making a test API call
 */
const validateAWSCredentials = async (credentials: any) => {
  try {
    const provider = getProvider('aws', credentials);
    await provider.validateCredentials();
    return { valid: true, message: 'AWS credentials validated' };
  } catch (error) {
    console.error('AWS validation failed:', error);
    return {
      valid: false,
      message: 'Invalid AWS credentials. Check Access Key ID, Secret Access Key, and region.',
    };
  }
};

/**
 * Validate Azure credentials
 */
const validateAzureCredentials = async (credentials: any) => {
  try {
    const provider = getProvider('azure', credentials);
    await provider.validateCredentials();
    return { valid: true, message: 'Azure credentials validated' };
  } catch (error) {
    console.error('Azure validation failed:', error);
    return {
      valid: false,
      message: 'Invalid Azure credentials. Check subscription ID, client ID, secret, and tenant ID.',
    };
  }
};

/**
 * Validate GCP credentials
 */
const validateGCPCredentials = async (credentials: any) => {
  try {
    const provider = getProvider('gcp', credentials);
    await provider.validateCredentials();
    return { valid: true, message: 'GCP credentials validated' };
  } catch (error) {
    console.error('GCP validation failed:', error);
    return {
      valid: false,
      message: 'Invalid GCP credentials. Check service account key and project ID.',
    };
  }
};

/**
 * Validate Oracle credentials
 */
const validateOracleCredentials = async (credentials: any) => {
  try {
    const provider = getProvider('oracle', credentials);
    await provider.validateCredentials();
    return { valid: true, message: 'Oracle credentials validated' };
  } catch (error) {
    console.error('Oracle validation failed:', error);
    return {
      valid: false,
      message: 'Invalid Oracle credentials. Check compartment ID, user ID, tenancy, and private key.',
    };
  }
};

// Dispatcher for validation based on provider
const validateCredentials = async (provider: string, credentials: any) => {
  switch (provider.toLowerCase()) {
    case 'aws':
      return validateAWSCredentials(credentials);
    case 'azure':
      return validateAzureCredentials(credentials);
    case 'gcp':
      return validateGCPCredentials(credentials);
    case 'oracle':
      return validateOracleCredentials(credentials);
    default:
      return { valid: false, message: 'Unknown provider' };
  }
};

// ============================================================================
// API ENDPOINTS
// ============================================================================

/**
 * POST /api/auth/cloud-credentials
 * Store encrypted cloud provider credentials for the authenticated user
 *
 * Request body:
 * {
 *   "provider": "aws",
 *   "credentials": {
 *     "accessKeyId": "AKIA...",
 *     "secretAccessKey": "wJal...",
 *     "region": "us-east-1"
 *   }
 * }
 */
router.post('/cloud-credentials', async (req: Request, res: Response) => {
  try {
    const userId = req.userId;
    if (!userId) {
      return res.status(401).json({ error: 'Unauthorized' });
    }

    const { provider, credentials } = req.body;

    if (!provider || !credentials) {
      return res.status(400).json({ error: 'Provider and credentials required' });
    }

    // Validate credentials against actual cloud provider
    const validation = await validateCredentials(provider, credentials);
    if (!validation.valid) {
      return res.status(400).json({
        error: 'Credential validation failed',
        details: validation.message,
      });
    }

    // Encrypt credentials
    const encrypted = encryptCredentials(credentials);

    // Store in database (upsert - one credential per user per provider)
    await query(
      `INSERT INTO cloud_credentials (user_id, provider, encrypted_data)
       VALUES ($1, $2, $3)
       ON CONFLICT(user_id, provider) DO UPDATE
       SET encrypted_data = EXCLUDED.encrypted_data,
           created_at = CURRENT_TIMESTAMP`,
      [userId, provider, JSON.stringify(encrypted)]
    );

    console.log(`[AUTH] User ${userId} stored ${provider} credentials (encrypted)`);

    res.json({
      success: true,
      message: `${provider.toUpperCase()} credentials saved securely`,
      provider,
    });
  } catch (error) {
    console.error('Cloud credentials storage error:', error);
    res.status(500).json({ error: 'Failed to store credentials', details: String(error) });
  }
});

/**
 * GET /api/auth/cloud-credentials
 * List which providers the user has configured (without returning credentials)
 */
router.get('/cloud-credentials', async (req: Request, res: Response) => {
  try {
    const userId = req.userId;
    if (!userId) {
      return res.status(401).json({ error: 'Unauthorized' });
    }

    const result = await query(
      `SELECT provider, created_at FROM cloud_credentials WHERE user_id = $1`,
      [userId]
    );

    res.json({
      providers: result.rows.map((row) => ({
        provider: row.provider,
        configured: true,
        lastUpdated: row.created_at,
      })),
    });
  } catch (error) {
    console.error('Get cloud credentials error:', error);
    res.status(500).json({ error: 'Failed to fetch configured providers' });
  }
});

/**
 * DELETE /api/auth/cloud-credentials/:provider
 * Remove stored credentials for a provider
 */
router.delete('/cloud-credentials/:provider', async (req: Request, res: Response) => {
  try {
    const userId = req.userId;
    if (!userId) {
      return res.status(401).json({ error: 'Unauthorized' });
    }

    const { provider } = req.params;

    await query(
      `DELETE FROM cloud_credentials WHERE user_id = $1 AND provider = $2`,
      [userId, provider]
    );

    console.log(`[AUTH] User ${userId} deleted ${provider} credentials`);

    res.json({
      success: true,
      message: `${provider.toUpperCase()} credentials removed`,
    });
  } catch (error) {
    console.error('Delete cloud credentials error:', error);
    res.status(500).json({ error: 'Failed to delete credentials' });
  }
});

// ============================================================================
// INTERNAL UTILITIES (for backend services)
// ============================================================================

/**
 * Get decrypted credentials for a user
 * Called internally when backend needs to use credentials
 *
 * Usage in other services:
 * const creds = await getCredentialsForUser(userId, 'aws');
 * const provider = getProvider('aws', creds);
 */
export const getCredentialsForUser = async (userId: string, providerName: string) => {
  const result = await query(
    `SELECT encrypted_data FROM cloud_credentials
     WHERE user_id = $1 AND provider = $2`,
    [userId, providerName]
  );

  if (result.rows.length === 0) {
    throw new Error(`No credentials configured for ${providerName}`);
  }

  const encrypted = JSON.parse(result.rows[0].encrypted_data);
  return decryptCredentials(encrypted);
};

/**
 * Check if user has credentials for a provider
 */
export const hasCredentialsForProvider = async (userId: string, provider: string) => {
  const result = await query(
    `SELECT 1 FROM cloud_credentials
     WHERE user_id = $1 AND provider = $2 LIMIT 1`,
    [userId, provider]
  );

  return result.rows.length > 0;
};

export default router;
